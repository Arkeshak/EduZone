PORT=5000
DB_NAME=eduzone
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql

# ============================================================
# JWT CONFIGURATION (CRITICAL: Use DIFFERENT secrets!)
# ============================================================
# Generate strong secrets using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Access Token Secret (short-lived, ~15 minutes)
JWT_ACCESS_SECRET=your_long_random_access_secret_minimum_32_characters_required_here_1234567890

# Refresh Token Secret (long-lived, ~7 days) - MUST BE DIFFERENT from ACCESS
JWT_REFRESH_SECRET=your_long_random_refresh_secret_minimum_32_characters_required_here_0987654321

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=eduzone-backend
JWT_AUDIENCE=eduzone-app

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
FRONTEND_URL=http://localhost:5173

# ============================================================
# CORS CONFIGURATION (Comma-separated list)
# ============================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# EMAIL SERVICE (Using Nodemailer with Gmail)
# ============================================================
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_RETRY_ENABLED=true
EMAIL_RETRY_DELAY_MS=2000
EMAIL_TIMEOUT=10000

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# PASSWORD RESET (Timing Attack Prevention)
# ============================================================
PASSWORD_RESET_EXPIRY_MINUTES=30
PASSWORD_RESET_MIN_RESPONSE_TIME_MS=1000

# ============================================================
# SECURITY
# ============================================================
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true

# ============================================================
# NODE CONFIGURATION
# ============================================================
NODE_ENV=development
IS_PRODUCTION=false

